{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // ---------------------------------------------------------------------------
  // Shared Renovate preset. Adopt it with a one-line renovate.json:
  //
  //   { "extends": ["github>noahkiss/renovate-config"] }
  //
  // JSONC, not JSON: Renovate parses JSON, JSONC and JSON5 preset files, so the
  // comments below survive. The file MUST be named default.json — a bare
  // `github>owner/repo` reference resolves that exact name, and a default.json5
  // would be unreachable without spelling the filename at every call site.
  //
  // AUTOMERGE IS GATED BY RENOVATE, NOT BY GITHUB. The one rule at the bottom
  // automerges devDependency patch and minor updates with platformAutomerge
  // off, so Renovate itself checks the PR's status checks and check runs on a
  // later run and merges only when every one has passed. A pending, running or
  // failed check blocks the merge, and so does a branch with no checks at all:
  // Renovate treats "no checks" as not green unless ignoreTests is true, which
  // this preset never sets. That gate needs no branch protection, so it holds
  // on private repos on GitHub's free plan, where branch protection is not
  // available.
  //
  // A repo with no CI on pull requests gets no automerge from this rule (the
  // gate never opens), but it must still extend the no-automerge variant so the
  // intent is explicit and the PR body does not advertise "Automerge: Enabled":
  //
  //   { "extends": ["github>noahkiss/renovate-config:no-automerge"] }
  // ---------------------------------------------------------------------------

  // config:recommended is the base every repo here already assumed. It brings
  // the dependency dashboard and the default grouping and range behaviour.
  // Semantic-commit handling is deliberately NOT set: Renovate detects it from
  // each repo's own history, and forcing one answer fleet-wide would override
  // repos that do use conventional commits.
  "extends": ["config:recommended"],

  "timezone": "America/New_York",

  // One review window for every repo, so PRs never arrive mid-workday.
  "schedule": ["* 0-6 * * *"],

  // The cheapest supply-chain control available: a release must have been
  // public for three days before Renovate will offer it. Applies to every
  // ecosystem.
  "minimumReleaseAge": "3 days",

  "labels": ["renovate"],
  "dependencyDashboard": true,

  // NO prConcurrentLimit AND NO prHourlyLimit, on purpose, and adopting repos
  // must not add them. A throttle does not reduce risk; it hides pending
  // updates behind a dashboard checkbox. The nightly `schedule` above is the
  // only pacing this fleet wants, and nothing ships until a PR is merged, so a
  // long open-PR list costs list length and nothing else.

  // A CVE fix should not wait for the overnight window.
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [],
    "labels": ["renovate", "security"]
  },
  "osvVulnerabilityAlerts": true,

  "packageRules": [
    {
      // devDependencies only, and only patch and minor. A devDependency never
      // reaches the shipped artifact, so the PR's own test run is the entire
      // risk surface. Production dependencies, majors, base images and GitHub
      // Actions are all merged by hand.
      //
      // platformAutomerge is OFF on purpose. With it on, GitHub's auto-merge
      // does the merge and waits only for REQUIRED checks, and a private repo
      // on the free plan cannot make any check required, so it would merge
      // before CI finished. With it off, Renovate merges the PR itself on a
      // subsequent run, and only when the branch is green: every status
      // success and every check run concluded success, neutral or skipped.
      // Pending or in-progress is not green. No checks at all is not green.
      // Renovate's own renovate/stability-days status does not count toward
      // green, so a repo whose only check is Renovate's never merges.
      //
      // ignoreTests stays at its default (false). Never set it true here: it
      // makes Renovate merge with no checks at all.
      //
      // Scope note: `devDependencies` is the npm depType. Python (pep621) dev
      // groups carry different depType names and are NOT covered here — they
      // stay manual, which is the safe direction.
      "description": "Automerge devDependency patch and minor updates once Renovate sees every PR check pass.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
