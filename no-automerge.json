{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // ---------------------------------------------------------------------------
  // The shared preset with automerge switched off, for a repo that runs no CI
  // on pull requests. Adopt it with:
  //
  //   { "extends": ["github>noahkiss/renovate-config:no-automerge"] }
  //
  // Everything else — schedule, minimumReleaseAge, labels, vulnerability alert
  // handling — is inherited unchanged from default.json.
  //
  // The plain preset's gate is Renovate-side (platformAutomerge off), so it
  // would never open in a repo with no PR checks anyway. This variant exists so
  // that repo says so explicitly instead of relying on the gate staying shut.
  // Move a repo off it onto the plain one once it has a workflow that runs on
  // `pull_request`. Branch protection is not required.
  // ---------------------------------------------------------------------------

  "description": "Shared preset with automerge disabled, for repos with no CI on pull requests.",
  "extends": ["github>noahkiss/renovate-config"],

  "packageRules": [
    {
      // Last rule wins in Renovate, and this file's rules are appended after
      // the ones default.json contributes, so this switches off the inherited
      // devDependency automerge for every package.
      "description": "No automerge anywhere in this repo.",
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ]
}
